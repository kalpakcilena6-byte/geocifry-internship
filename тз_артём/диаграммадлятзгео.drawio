  <diagram id="flow" name="Загрузка версии">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" value="&lt;b&gt;Клиент&lt;/b&gt;&lt;br&gt;POST /templates/{template_id}/versions&lt;br&gt;multipart: file, change_note, confirm_page_change (необязательно); заголовок X-User-Login" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="40" y="40" width="480" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;401&lt;/b&gt; нет X-User-Login" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;spacing=8;dashed=1;" parent="1" vertex="1">
          <mxGeometry x="640" y="40" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="ошибка" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="c1" target="c2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;FastAPI: приём запроса&lt;/b&gt;&lt;br&gt;размер файла не больше 20 МБ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="40" y="190" width="480" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;" edge="1" parent="1" source="c1" target="c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;413&lt;/b&gt; файл больше 20 МБ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;spacing=8;dashed=1;" parent="1" vertex="1">
          <mxGeometry x="640" y="190" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="ошибка" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="c4" target="c6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;b&gt;Python: проверка формата&lt;/b&gt;&lt;br&gt;zip → первая запись mimetype без сжатия → odt или ott → content.xml, styles.xml, manifest.xml разбираются как XML → расширение совпадает с mimetype" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="40" y="340" width="480" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;" edge="1" parent="1" source="c4" target="c8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="&lt;b&gt;415&lt;/b&gt; не ODT/OTT или расширение не совпадает" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;spacing=8;dashed=1;" parent="1" vertex="1">
          <mxGeometry x="640" y="340" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="ошибка" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="c8" target="c10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="&lt;b&gt;Python: разбор файла&lt;/b&gt;&lt;br&gt;sha256 и размер; поля и текст из content.xml; ширина и высота основной страницы из styles.xml" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="40" y="490" width="480" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;" edge="1" parent="1" source="c8" target="c12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="&lt;b&gt;PostgreSQL: транзакция&lt;/b&gt;&lt;br&gt;select … from template where template_id = … for update&lt;br&gt;последняя версия: minor_version, file_sha256, ширина и высота листа" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="40" y="640" width="480" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;" edge="1" parent="1" source="c12" target="c14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c16" value="&lt;b&gt;404&lt;/b&gt; шаблон не найден&lt;br&gt;&lt;b&gt;409&lt;/b&gt; хеш совпадает с последней версией" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;spacing=8;dashed=1;" parent="1" vertex="1">
          <mxGeometry x="640" y="640" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c17" value="ошибка" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="c14" target="c16">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c18" value="&lt;b&gt;Python: проверка листа&lt;/b&gt;&lt;br&gt;ширина и высота совпадают с последней версией (допуск 2 мм) или передано confirm_page_change=true" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="40" y="790" width="480" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;" edge="1" parent="1" source="c14" target="c18">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c20" value="&lt;b&gt;422&lt;/b&gt; размер листа изменился без подтверждения; транзакция откатывается" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;spacing=8;dashed=1;" parent="1" vertex="1">
          <mxGeometry x="640" y="790" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c21" value="ошибка" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="c18" target="c20">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c22" value="&lt;b&gt;save_file()&lt;/b&gt;&lt;br&gt;templates/{template_id}/1.{minor + 1}.{format}&lt;br&gt;временный файл → os.replace" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="40" y="940" width="480" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;" edge="1" parent="1" source="c18" target="c22">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c24" value="&lt;b&gt;503&lt;/b&gt; хранилище недоступно, транзакция откатывается" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;spacing=8;dashed=1;" parent="1" vertex="1">
          <mxGeometry x="640" y="940" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c25" value="ошибка" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="c22" target="c24">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c26" value="&lt;b&gt;insert в template_version&lt;/b&gt;&lt;br&gt;minor_version = последний + 1&lt;br&gt;created_* = updated_* = исполнитель и время запроса; commit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="40" y="1090" width="480" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;" edge="1" parent="1" source="c22" target="c26">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c28" value="&lt;b&gt;Ответ 201&lt;/b&gt;&lt;br&gt;JSON версии: template_id, version &quot;1.4&quot;, title и description из template, file_format, size_in_bytes, page_format, orientation, fields, created_by, created_at" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="40" y="1240" width="480" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;fontColor=#000000;" edge="1" parent="1" source="c26" target="c28">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c30" value="Сплошные стрелки: успешный путь. Пунктир: ответ с ошибкой, дальше запрос не идёт." style="text;html=1;align=left;verticalAlign=top;fontColor=#000000;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="640" y="1240" width="340" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="api" name="Операции API">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" value="&lt;b&gt;Операции API и бизнес-процессы&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table style=&quot;border-collapse:collapse;font-size:12px;&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;Запрос&lt;/th&gt;&lt;th style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;Бизнес-операция&lt;/th&gt;&lt;th style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;Что делает сервис&lt;/th&gt;&lt;th style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;Успех&lt;/th&gt;&lt;th style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;Ошибки&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;POST /templates&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;создать шаблон: template_id, title, description, file, change_note&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;проверка файла; insert template и версии 1.0 в одной транзакции&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;201&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;401, 409 (template_id занят), 413, 415, 422&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;POST /templates/{id}/versions&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;загрузить новую версию: file, change_note, confirm_page_change&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;блокировка карточки; сравнение хеша и размера листа с последней версией; номер = последний + 1&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;201&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;401, 404, 409, 413, 415, 422 (лист изменился без подтверждения), 503&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;GET /templates?q=аренд&amp;amp;text=акт приёмки&amp;amp;page_format=a4&amp;amp;orientation=landscape&amp;amp;limit=20&amp;amp;offset=0&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;каталог: поиск по названию и тексту, фильтр по листу, постранично&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;q: title ilike (индекс pg_trgm); text: полнотекстовый поиск по актуальным версиям (индекс gin); page_format, orientation: по актуальной версии&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;200&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;422&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;GET /templates/{id}&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;карточка и актуальная версия&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;select карточки и версии с наибольшим номером&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;200&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;404&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;GET /templates/{id}/versions&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;история: номер, дата, автор, change_note&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;order by minor_version desc&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;200&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;404&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;GET /templates/{id}/versions/{1.N или latest}&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;одна версия со всеми сведениями&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;«1.3» → minor_version = 3; другой вид номера → 422&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;200&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;404, 422&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;GET /templates/{id}/versions/{1.N}/file&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;скачать файл&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;Content-Type по file_format; имя «название_v1.3.odt»; хеш файла сверяется с file_sha256&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;200&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;404, 500 (файл повреждён или пропал)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;PATCH /templates/{id}&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;изменить title или description&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;клиент присылает updated_at, который видел; update … where updated_at = присланное&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;200&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;401, 404, 409 (карточку уже изменили), 422&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;PATCH /templates/{id}/versions/{1.N}&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;исправить change_note&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;менять можно только change_note; остальные поля → 422&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;200&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:4px 8px;vertical-align:top;&quot;&gt;401, 404, 422&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;Все ответы с ошибкой имеют вид {&quot;error&quot;: {&quot;code&quot;: &quot;...&quot;, &quot;message&quot;: &quot;...&quot;}}. Операции записи требуют заголовок X-User-Login, чтение доступно без него." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=10;fillColor=none;strokeColor=#000000;fontColor=#000000;" parent="1" vertex="1">
          <mxGeometry x="40" y="40" width="1500" height="700" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
